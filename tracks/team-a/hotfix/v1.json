{
  "id": "hotfix",
  "name": "Hotfix Deployment",
  "version": 1,
  "status": "published",
  "team": "team-a",
  "description": "Hotfix fast-track — collect hotfix key, validate, deploy and notify.",
  "variables": {
    "hotfix_key": "",
    "env": "prod",
    "approved": false
  },
  "steps": [
    {
      "id": "get-hotfix",
      "type": "input",
      "name": "Get Hotfix Key",
      "config": {
        "prompt": "Enter hotfix key (e.g. HOTFIX-42)",
        "variable": "hotfix_key",
        "required": true,
        "placeholder": "HOTFIX-42"
      },
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "validate-hotfix",
      "type": "validation",
      "name": "Validate Hotfix",
      "config": {
        "rules": [
          {
            "field": "variables.hotfix_key",
            "operator": "regex",
            "value": "^HOTFIX-\\d+$",
            "message": "Hotfix key must match HOTFIX-<number>"
          }
        ],
        "on_failure": "fail"
      },
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "deploy-hotfix",
      "type": "action",
      "name": "Deploy Hotfix",
      "config": {
        "action": "deploy_hotfix",
        "params": {
          "hotfix_key": "{{variables.hotfix_key}}",
          "env": "{{variables.env}}"
        },
        "timeout_seconds": 400
      },
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "notify",
      "type": "message",
      "name": "Notify",
      "config": {
        "text": "🔥 Hotfix {{variables.hotfix_key}} deployed to {{variables.env}}. Please verify.",
        "markdown": true
      },
      "position": {
        "x": 850,
        "y": 100
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "get-hotfix",
      "to": "validate-hotfix",
      "label": "next"
    },
    {
      "id": "t2",
      "from": "validate-hotfix",
      "to": "deploy-hotfix",
      "label": "valid"
    },
    {
      "id": "t3",
      "from": "deploy-hotfix",
      "to": "notify",
      "label": "deployed"
    }
  ],
  "llm_config": {
    "provider": "mistral",
    "model": "mistral-small-latest",
    "temperature": 0.5,
    "max_tokens": 512,
    "system_prompt": null
  },
  "settings": {
    "timeout_hours": 6,
    "max_retries": 1,
    "allow_parallel": false
  },
  "integrations": {},
  "created_at": "2026-05-01T09:00:00+00:00",
  "updated_at": "2026-08-24T10:00:00+00:00"
}
