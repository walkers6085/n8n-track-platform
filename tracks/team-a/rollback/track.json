{
  "id": "rollback",
  "name": "Rollback Release",
  "version": 1,
  "status": "published",
  "team": "team-a",
  "description": "Emergency rollback workflow for Team A — approval, rollback action, verification and notification.",
  "variables": {
    "story_key": "",
    "env": "staging",
    "approved": false,
    "rollback_status": ""
  },
  "steps": [
    {
      "id": "confirm-rollback",
      "type": "approval",
      "name": "Confirm Rollback",
      "config": {
        "prompt": "Confirm rollback of {{variables.story_key}} on {{variables.env}}?",
        "approvers": ["team-lead"],
        "timeout_hours": 4,
        "variable": "approved",
        "require_comment": true
      },
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "rollback",
      "type": "action",
      "name": "Execute Rollback",
      "config": {
        "action": "rollback_release",
        "params": {
          "story_key": "{{variables.story_key}}",
          "env": "{{variables.env}}"
        },
        "timeout_seconds": 300
      },
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "verify-rollback",
      "type": "validation",
      "name": "Verify Rollback",
      "config": {
        "rules": [
          {
            "field": "variables.rollback_status",
            "operator": "equals",
            "value": "success",
            "message": "Rollback must succeed"
          }
        ],
        "on_failure": "fail"
      },
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "notify",
      "type": "message",
      "name": "Notify",
      "config": {
        "text": "↩️ Rollback of {{variables.story_key}} on {{variables.env}} completed. Status: {{variables.rollback_status}}",
        "markdown": true
      },
      "position": {
        "x": 850,
        "y": 100
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "confirm-rollback",
      "to": "rollback",
      "condition": "variables.approved == true",
      "label": "approved"
    },
    {
      "id": "t2",
      "from": "confirm-rollback",
      "to": "notify",
      "condition": "variables.approved != true",
      "label": "rejected"
    },
    {
      "id": "t3",
      "from": "rollback",
      "to": "verify-rollback",
      "label": "executed"
    },
    {
      "id": "t4",
      "from": "verify-rollback",
      "to": "notify",
      "label": "verified"
    }
  ],
  "llm_config": {
    "provider": "mistral",
    "model": "mistral-small-latest",
    "temperature": 0.5,
    "max_tokens": 512,
    "system_prompt": null
  },
  "settings": {
    "timeout_hours": 12,
    "max_retries": 1,
    "allow_parallel": false
  },
  "integrations": {},
  "created_at": "2026-04-10T09:00:00+00:00",
  "updated_at": "2026-08-24T10:00:00+00:00"
}
