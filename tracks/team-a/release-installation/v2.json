{
  "id": "release-installation",
  "name": "Release Installation",
  "version": 2,
  "status": "published",
  "team": "team-a",
  "description": "Standard release installation pipeline for Team A — Jira validation, env gating, approval and install.",
  "variables": {
    "team_id": "",
    "story_key": "",
    "env": "staging",
    "approved": false
  },
  "steps": [
    {
      "id": "get-team",
      "type": "input",
      "name": "Get Team",
      "config": {
        "prompt": "Enter team identifier (e.g. team-a)",
        "variable": "team_id",
        "required": true,
        "placeholder": "team-a"
      },
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "get-story",
      "type": "input",
      "name": "Get Story",
      "config": {
        "prompt": "Enter Jira story key (e.g. PROJ-123)",
        "variable": "story_key",
        "required": true,
        "placeholder": "PROJ-123"
      },
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "read-jira",
      "type": "jira",
      "name": "Read Jira",
      "config": {
        "method": "GET",
        "story_key": "{{variables.story_key}}",
        "jql": "key = {{variables.story_key}}",
        "endpoint": "https://jira.example.com/rest/api/2/issue/{{variables.story_key}}",
        "output_variable": "jira_issue"
      },
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "validate-story",
      "type": "validation",
      "name": "Validate Story",
      "config": {
        "rules": [
          {
            "field": "variables.jira_issue.fields.status.name",
            "operator": "equals",
            "value": "Ready for Release",
            "message": "Story must be Ready for Release"
          },
          {
            "field": "variables.story_key",
            "operator": "regex",
            "value": "^[A-Z]+-\\d+$",
            "message": "Story key format invalid"
          }
        ],
        "on_failure": "fail"
      },
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "check-env",
      "type": "condition",
      "name": "Check Environment",
      "config": {
        "expression": "variables.env == 'prod'",
        "description": "Branch to approval if prod, otherwise direct install"
      },
      "position": {
        "x": 900,
        "y": 100
      }
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approval",
      "config": {
        "prompt": "Approve release {{variables.story_key}} to {{variables.env}}?",
        "approvers": [
          "team-lead",
          "release-manager"
        ],
        "timeout_hours": 24,
        "variable": "approved",
        "require_comment": false
      },
      "position": {
        "x": 1100,
        "y": 50
      }
    },
    {
      "id": "install",
      "type": "action",
      "name": "Install Release",
      "config": {
        "action": "install_release",
        "params": {
          "story_key": "{{variables.story_key}}",
          "env": "{{variables.env}}",
          "team_id": "{{variables.team_id}}"
        },
        "timeout_seconds": 600,
        "retry_on_failure": 1
      },
      "position": {
        "x": 1300,
        "y": 100
      }
    },
    {
      "id": "verify",
      "type": "validation",
      "name": "Verify Install",
      "config": {
        "rules": [
          {
            "field": "variables.install_status",
            "operator": "equals",
            "value": "success",
            "message": "Install must succeed"
          }
        ],
        "on_failure": "retry"
      },
      "position": {
        "x": 1500,
        "y": 100
      }
    },
    {
      "id": "finish",
      "type": "message",
      "name": "Finish",
      "config": {
        "text": "✅ Release {{variables.story_key}} successfully installed to {{variables.env}} by team {{variables.team_id}}. All checks passed.",
        "markdown": true
      },
      "position": {
        "x": 1700,
        "y": 100
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "get-team",
      "to": "get-story",
      "label": "next"
    },
    {
      "id": "t2",
      "from": "get-story",
      "to": "read-jira",
      "label": "next"
    },
    {
      "id": "t3",
      "from": "read-jira",
      "to": "validate-story",
      "label": "jira fetched"
    },
    {
      "id": "t4",
      "from": "validate-story",
      "to": "check-env",
      "label": "valid"
    },
    {
      "id": "t5",
      "from": "check-env",
      "to": "approval",
      "condition": "variables.env == 'prod'",
      "label": "prod → approval"
    },
    {
      "id": "t6",
      "from": "check-env",
      "to": "install",
      "condition": "variables.env != 'prod'",
      "label": "non-prod → install"
    },
    {
      "id": "t7",
      "from": "approval",
      "to": "install",
      "condition": "variables.approved == true",
      "label": "approved"
    },
    {
      "id": "t8",
      "from": "approval",
      "to": "finish",
      "condition": "variables.approved != true",
      "label": "rejected → finish"
    },
    {
      "id": "t9",
      "from": "install",
      "to": "verify",
      "label": "installed"
    },
    {
      "id": "t10",
      "from": "verify",
      "to": "finish",
      "label": "verified"
    }
  ],
  "llm_config": {
    "provider": "mistral",
    "model": "mistral-small-latest",
    "temperature": 0.7,
    "max_tokens": 1024,
    "system_prompt": null
  },
  "settings": {
    "timeout_hours": 48,
    "max_retries": 2,
    "allow_parallel": false
  },
  "integrations": {
    "jira": {
      "base_url": "https://jira.example.com",
      "project": "PROJ"
    }
  },
  "created_at": "2026-03-01T10:00:00+00:00",
  "updated_at": "2026-04-01T10:00:00+00:00"
}